          "body_file": "resources/security-octo-supply/pr-typescript/pr-body.md"
        },
        {
          "branch": "feature/supplier-notes",
          "resource_dir": "resources/security-octo-supply/pr-php",
          "commit_message": "feat: add supplier notes feature for internal communication",
          "title": "Demo: Preventing Vulnerabilities in PHP",
          "body_file": "resources/security-octo-supply/pr-php/pr-body.md"
        }
      ],
      "summary_lines": [
        "Security features: Enabled",
        "PRs: TypeScript + PHP demo PRs created"
      ]
    },
